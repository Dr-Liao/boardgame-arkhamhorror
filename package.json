{
  "name": "dsh-boardgame-arkhamhorror",
  "description": "桌游大厅 Mod：诡镇奇谈 · 卡牌版（Arkham Horror LCG），放在大厅的 games/arkhamhorror 下运行",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "main": "index.js",
  "scripts": {
    "test": "node tools/run-tests.mjs all",
    "test:node": "node --test tests/node-suite.mjs",
    "test:fast": "node tools/run-tests.mjs fast",
    "test:slow": "node tools/run-tests.mjs slow",
    "test:assets": "node tools/run-tests.mjs assets",
    "test:all": "node tools/run-tests.mjs all",
    "test:dunwich": "node --test tests/dunwich-migration.test.mjs tests/dunwich-rules.test.mjs",
    "test:dunwich:acceptance": "node --test tests/dunwich-player-acceptance.test.mjs tests/dunwich-encounter-acceptance.test.mjs tests/dunwich-scenario-acceptance.test.mjs tests/dunwich-ledger.test.mjs",
    "audit:dunwich": "node tools/audit-dunwich.mjs --check",
    "audit:dunwich:acceptance": "node tools/audit-dunwich-acceptance.mjs",
    "import:dunwich-story": "node tools/import-dunwich-story.mjs --write",
    "import:dunwich-story:check": "node tools/import-dunwich-story.mjs --check",
    "test:carcosa": "node --test tests/carcosa-*.test.mjs",
    "test:carcosa:player": "node --test tests/carcosa-player-acceptance.test.mjs",
    "test:carcosa:cards": "node --test tests/carcosa-campaign-card-acceptance.test.mjs tests/carcosa-all-card-ledger.test.mjs",
    "test:carcosa:scenario": "node --test tests/carcosa-opening.test.mjs tests/carcosa-middle-a.test.mjs tests/carcosa-middle-b.test.mjs tests/carcosa-final.test.mjs tests/carcosa-campaign.test.mjs tests/carcosa-scenario-acceptance.test.mjs",
    "test:carcosa:browser": "playwright test --config playwright.config.mjs carcosa-rules.browser.mjs",
    "import:carcosa-story": "node tools/import-carcosa-story.mjs --write",
    "import:carcosa-story:check": "node tools/import-carcosa-story.mjs --check",
    "audit:carcosa": "node tools/audit-carcosa.mjs --check",
    "audit:carcosa:player": "node tools/audit-carcosa-player.mjs",
    "audit:carcosa:cards": "node tools/audit-carcosa-all-cards.mjs",
    "audit:carcosa:scenario": "node tools/audit-carcosa-scenarios.mjs --check",
    "test:tfa": "node --test tests/tfa-migration.test.mjs",
    "audit:tfa": "node tools/audit-tfa.mjs --check",
    "audit:tfa:write": "node tools/audit-tfa.mjs --write",
    "test:p6": "node --test tests/p6-content.test.mjs",
    "test:core": "node tools/audit-core-acceptance.mjs --check",
    "test:ai": "node --test tests/ai-completion.test.mjs",
    "evaluate:ai": "node tools/evaluate-ai.mjs",
    "audit:p6": "node tools/audit-p6.mjs --check",
    "audit:p6:write": "node tools/audit-p6.mjs --write",
    "test:audit": "node --test tests/audit-resources.test.mjs",
    "test:browser": "node tools/run-p7.mjs --browser-only",
    "pretest:browser": "node ../../tools/require-playwright-browsers.mjs",
    "audit": "node tools/audit-resources.mjs --summary",
    "audit:check": "node tools/audit-resources.mjs --check",
    "audit:source": "node tools/audit-resources.mjs --check-source",
    "import": "node tools/import-cards.mjs --write",
    "import:check": "node tools/import-cards.mjs --check",
    "presentation": "node tools/build-presentation.mjs --summary",
    "presentation:write": "node tools/build-presentation.mjs --write",
    "presentation:check": "node tools/build-presentation.mjs --check",
    "images:estimate": "node tools/fetch-images.mjs --estimate --scope=manifest",
    "images:fetch": "node tools/fetch-images.mjs --download --scope=manifest",
    "images:verify": "node tools/fetch-images.mjs --verify --scope=manifest",
    "images:translate:estimate": "node tools/translate-images.mjs --estimate",
    "images:translate:pilot": "node tools/translate-images.mjs --manifest --limit=10 --manifest-path=web/img/.translation/pilot.json",
    "images:translate": "node tools/translate-images.mjs --manifest --manifest-path=web/img/.translation/full.json",
    "images:translate:direct": "node tools/translate-images.mjs --run",
    "images:translate:verify": "node tools/translate-images.mjs --verify",
    "test:p7": "node tools/run-p7.mjs",
    "test:release": "node tools/run-p7.mjs --release"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "sharp": "^0.35.5"
  },
  "license": "MIT"
}
