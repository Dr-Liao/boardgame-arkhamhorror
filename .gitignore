node_modules/

# 浏览器回归（Playwright）的临时输出
test-results/
playwright-report/

# 本地卡图库（约 1.9 GB，按需用 tools/fetch-images.mjs 重新抓取，或由图片缓存自动下载；
# 美术版权归 FFG，不要提交或再分发）
web/img/cards/
web/img/zh/
# 卡图翻译任务的中间清单
web/img/.translation/

# 本地验收截图 / 临时产物：默认忽略整个 artifacts/。
# 例外（必须入库）：audit-tcu / audit-tcu-primitives 的 --check 依赖
# artifacts/migration/tcu/{scope,mechanism-scan,primitive-plan,primitive-catalog}.json，
# 干净检出必须能直接复算；git 的否定规则要求逐级放开父目录，所以用「忽略子项 + 逐级取反」，
# 而不是只写 !artifacts/migration/tcu/（父目录仍被忽略时否定规则不生效），也不放开整个 artifacts/。
artifacts/*
!artifacts/migration/
artifacts/migration/*
!artifacts/migration/tcu/

# Player-owned playlist settings and music additions (directory markers stay tracked).
web/audio/music/playlists.json
web/audio/music/campaigns/**/*.mp3
web/audio/music/campaigns/**/*.ogg
web/audio/music/campaigns/**/*.wav
web/audio/music/campaigns/**/*.m4a
web/audio/music/campaigns/**/*.aac
web/audio/music/campaigns/**/*.flac
web/audio/music/campaigns/**/*.webm
